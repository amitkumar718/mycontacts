<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toggle strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnToggleDuplicates"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginRight="6dp"
            android:text="@string/sync_tab_duplicates"
            android:textSize="12sp"
            android:background="@drawable/bg_toggle_active"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnToggleArchiveOnly"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/sync_tab_archive_only"
            android:textSize="12sp"
            android:background="@drawable/bg_toggle_inactive"
            android:textColor="#1565C0" />

    </LinearLayout>

    <!-- Status + spinner row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/syncProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#757575" />

    </LinearLayout>

    <!-- Hint line (shown when list is populated) -->
    <TextView
        android:id="@+id/tvSyncHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:background="#F5F5F5"
        android:visibility="gone" />

    <!-- Select-all row (shown when list has items) -->
    <LinearLayout
        android:id="@+id/layoutSyncSelectAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbSyncSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textSize="12sp"
            android:textColor="#424242" />

        <TextView
            android:id="@+id/tvSyncSelectCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="12sp"
            android:textColor="#757575" />

    </LinearLayout>

    <!-- Contact list -->
    <ListView
        android:id="@+id/listSync"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#F0F0F0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvSyncEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#BDBDBD"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnSyncCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:background="@drawable/bg_toggle_inactive"
            android:textColor="#1565C0" />

        <Button
            android:id="@+id/btnSyncAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_delete"
            android:textSize="14sp"
            android:background="@drawable/bg_button_danger"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
