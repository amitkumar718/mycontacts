<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search toolbar -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1565C0"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_search"
                android:hint="@string/search_hint"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Count + view-mode toggle strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="#F5F5F5"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 archived"
                android:textColor="#757575"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnToggleAlpha"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="A-Z"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_toggle_active"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/title_labels"
                android:textSize="11sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_toggle_inactive"
                android:textColor="#1565C0" />

        </LinearLayout>

        <!-- List -->
        <ListView
            android:id="@+id/listArchived"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#F0F0F0"
            android:dividerHeight="1dp"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/empty_archived"
            android:textColor="#BDBDBD"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- FAB -->
    <Button
        android:id="@+id/fabArchive"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_fab"
        android:elevation="6dp" />

</FrameLayout>
